# Supabase PostgreSQL connection settings (configure in Railway; never commit real values).
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=
SUPABASE_DB_SSLMODE=require

# SmartExit API local/deployment settings.
PORT=3001
HOST=127.0.0.1
APP_ORIGIN=
NEAR_NETWORK=testnet

# Resend email
RESEND_API_KEY=
MAIL_FROM=

# Encryption key: 32 random bytes encoded as 64 hex characters.
BINANCE_CREDENTIALS_KEY=

# Generate a random secret of at least 32 characters. Set the same value in PHP and SmartExit API.
SMARTEXIT_BRIDGE_SECRET=
SMARTEXIT_API_URL=http://127.0.0.1:3001

# Set REQUIRE_VERCEL_PROXY=1 and the same secret in Vercel and Railway in production.
REQUIRE_VERCEL_PROXY=0
PHP_PROXY_SECRET=
PHP_ORIGIN=
