# Supabase PostgreSQL connection settings (configure privately in Vercel).
SUPABASE_DB_URL=
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=
SUPABASE_DB_SSLMODE=require
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=

# Authentication and email
RESEND_API_KEY=
MAIL_FROM=
GMAIL_USER=
GMAIL_APP_PASSWORD=
GMAIL_SMTP_PORT=465
APP_URL=
AUTH_SECRET=
BINANCE_CREDENTIALS_KEY=

# Binance Futures execution is disabled unless the deployment operator explicitly
# enables an environment after the corresponding Demo/Live validation.
BINANCE_FUTURES_TRADING_ENABLED=false
BINANCE_FUTURES_DEMO_TRADING_ENABLED=false
BINANCE_FUTURES_DEMO_VERIFIED=false
BINANCE_FUTURES_LIVE_TRADING_APPROVED=false

# Scheduled scans/news ingestion and Web Push (keep secrets private in deployment settings).
CRON_SECRET=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@example.com
SUBSCRIPTION_CONTACT_EMAIL=payments@example.com

# One-time admin setup: remove this after provisioning an administrator.
ADMIN_SETUP_TOKEN=
