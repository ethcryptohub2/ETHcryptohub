# Supabase PostgreSQL connection settings (configure privately in Vercel).
SUPABASE_DB_URL=
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=
SUPABASE_DB_SSLMODE=verify-full
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Set these only in Vercel deployment scopes; values are project metadata or a
# one-way key fingerprint, never database credentials or encryption key material.
SMARTEXIT_STAGING_SUPABASE_PROJECT_REF=
SMARTEXIT_PRODUCTION_SUPABASE_PROJECT_REF=
SMARTEXIT_PRODUCTION_BINANCE_CREDENTIALS_KEY_SHA256=
SMARTEXIT_DEPLOYMENT_ENV=
SMARTEXIT_UI_PREVIEW_ONLY=false
SMARTEXIT_UI_PREVIEW_BRANCH=

# Authentication and email
RESEND_API_KEY=
MAIL_FROM=
GMAIL_USER=
GMAIL_APP_PASSWORD=
GMAIL_SMTP_PORT=465
APP_URL=
AUTH_SECRET=
BINANCE_CREDENTIALS_KEY=

# Binance Futures execution is disabled unless the deployment operator explicitly
# enables an environment after the corresponding Demo/Live validation.
BINANCE_FUTURES_TRADING_ENABLED=false
BINANCE_FUTURES_DEMO_TRADING_ENABLED=false
BINANCE_FUTURES_DEMO_VERIFIED=false
BINANCE_FUTURES_LIVE_TRADING_APPROVED=false
BINANCE_DEMO_REMOTE_TESTS_AUTHORIZED=false

# Scheduled scans/news ingestion and Web Push (keep secrets private in deployment settings).
CRON_SECRET=
SMARTEXIT_CRON_RECONCILIATION_ENABLED=false
SMARTEXIT_CRON_TARGET_ENVIRONMENT=
SMARTEXIT_CRON_BASE_URL=
SMARTEXIT_STAGING_PREVIEW_URL=
SMARTEXIT_PRODUCTION_APP_URL=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@example.com
SUBSCRIPTION_CONTACT_EMAIL=payments@example.com

# One-time admin setup: remove this after provisioning an administrator.
ADMIN_SETUP_TOKEN=
SMARTEXIT_CUSTOMER_DEMO_AUTO_EXECUTION_ENABLED=false
