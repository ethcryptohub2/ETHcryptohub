# SmartExit 24x7 Isolated Demo Trading Worker Container
FROM node:22-alpine

WORKDIR /app

# Install production dependencies (includes pinned tsx runtime)
COPY package*.json ./
RUN npm ci --omit=dev

# Copy application code with non-root ownership
COPY --chown=node:node . .

# Ensure writable worker storage directory for non-root user
RUN mkdir -p /app/storage/demo-worker && chown -R node:node /app/storage

# Strict isolated sandbox defaults (override via --env-file in production/staging host)
ENV NODE_ENV=production
ENV SMARTEXIT_DEPLOYMENT_ENV=staging
ENV TRADING_ENVIRONMENT=DEMO
ENV SMARTEXIT_TRADING_ENVIRONMENT=DEMO
ENV WORKER_SAFE_MODE=true
ENV DEMO_ORDER_DISPATCH_ENABLED=false
ENV SMARTEXIT_EMERGENCY_STOP=false
ENV BINANCE_FUTURES_LIVE_TRADING_APPROVED=false

# Non-root user for security
USER node

# Healthcheck checking heartbeat freshness within 90 seconds and non-error status
HEALTHCHECK --interval=30s --timeout=10s --start-period=20s --retries=3 \
  CMD node -e " \
    const fs = require('fs'); \
    const hb = JSON.parse(fs.readFileSync('storage/demo-worker/worker-heartbeat.json', 'utf8')); \
    if (Date.now() - hb.timestamp > 90000 || !['RUNNING', 'STOPPED'].includes(hb.status) || (hb.consecutiveFailures || 0) > 0) process.exit(1); \
  "

# Run the persistent demo worker daemon via pinned tsx loader (no npx download)
CMD ["node", "--import", "tsx", "scripts/demo-trading-worker.mjs"]
