# SmartExit / ETHcryptohub — Render Environment Variables Template
# Set these in the Render Dashboard under your Web Service / Background Worker "Environment" tab.
# Staging Supabase project: SmartExit-Staging (ghecpkpaxbrvehquhzkr, ap-southeast-2)

# --- Runtime & Framework ---
NODE_ENV=production
SMARTEXIT_DEPLOYMENT_ENV=staging
TRADING_ENVIRONMENT=DEMO
SMARTEXIT_TRADING_ENVIRONMENT=DEMO

# --- Safety & SafeMode Locks (24h soak defaults: zero real orders) ---
WORKER_SAFE_MODE=true
DEMO_ORDER_DISPATCH_ENABLED=false
SMARTEXIT_EMERGENCY_STOP=false
BINANCE_FUTURES_LIVE_TRADING_APPROVED=false
BINANCE_FUTURES_LIVE_TRADING_ENABLED=false
SMARTEXIT_CRON_RECONCILIATION_ENABLED=false

# --- Supabase Staging Database Configuration ---
NEXT_PUBLIC_SUPABASE_URL=https://ghecpkpaxbrvehquhzkr.supabase.co
SMARTEXIT_STAGING_SUPABASE_PROJECT_REF=ghecpkpaxbrvehquhzkr
SMARTEXIT_PRODUCTION_SUPABASE_PROJECT_REF=kafsdnzzjawikoavkhvm
SUPABASE_DB_HOST=aws-0-ap-southeast-2.pooler.supabase.com
SUPABASE_DB_PORT=6543
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres.ghecpkpaxbrvehquhzkr
SUPABASE_DB_SSLMODE=verify-full

# --- Required Secrets (Enter your actual Staging secrets in Render Dashboard) ---
NEXT_PUBLIC_SUPABASE_ANON_KEY=<YOUR_STAGING_SUPABASE_ANON_KEY>
SUPABASE_SERVICE_ROLE_KEY=<YOUR_STAGING_SUPABASE_SERVICE_ROLE_KEY>
SUPABASE_DB_PASSWORD=<YOUR_STAGING_SUPABASE_DB_PASSWORD>
AUTH_SECRET=<MIN_32_CHAR_SECRET_HEX_OR_BASE64>
BINANCE_CREDENTIALS_KEY=<64_HEX_CHARACTERS_32_BYTES_ENCRYPTION_KEY>
CRON_SECRET=<MIN_32_CHAR_SECRET>
WORKER_SECRET=<MIN_32_CHAR_SECRET>

# --- Application URL (Set to your Render onrender.com domain) ---
APP_URL=https://smartexit-web.onrender.com

# --- Capability Gates (Keep false during SafeMode soak; enable after soak sign-off) ---
BINANCE_FUTURES_TRADING_ENABLED=false
BINANCE_FUTURES_DEMO_TRADING_ENABLED=false
BINANCE_FUTURES_DEMO_VERIFIED=false
SMARTEXIT_BYBIT_DEMO_ORDER_SUBMISSION_ENABLED=false
OKX_DEMO_ENABLED=false
