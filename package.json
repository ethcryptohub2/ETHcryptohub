{
  "name": "ethcryptohub",
  "private": true,
  "engines": {
    "node": ">=20.0.0 <28.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/validate-deployment-env.mjs",
    "build": "next build",
    "start": "next start",
    "worker:demo": "node --import tsx scripts/demo-trading-worker.mjs",
    "worker:demo:safe": "node --import tsx scripts/demo-trading-worker.mjs --safe-mode",
    "typecheck": "tsc --noEmit",
    "lint": "eslint app lib",
    "test:exchanges": "node --test lib/exchanges/*.test.mjs lib/*.test.mjs lib/intelligence/*.test.mjs scripts/*.test.mjs",
    "test:intelligence": "node --test lib/intelligence/*.test.mjs",
    "replay:intelligence": "node scripts/replay-intelligence.mjs",
    "setup:test-auth": "powershell.exe -NoProfile -ExecutionPolicy RemoteSigned -File scripts\\auth-e2e.ps1 -Mode setup",
    "test:auth:e2e": "powershell.exe -NoProfile -ExecutionPolicy RemoteSigned -File scripts\\auth-e2e.ps1 -Mode run -Suite auth",
    "test:admin:e2e": "powershell.exe -NoProfile -ExecutionPolicy RemoteSigned -File scripts\\auth-e2e.ps1 -Mode run -Suite admin",
    "test:user:e2e": "powershell.exe -NoProfile -ExecutionPolicy RemoteSigned -File scripts\\auth-e2e.ps1 -Mode run -Suite user",
    "validate:migrations": "node scripts/validate-migrations.mjs",
    "validate:deployment-env": "node scripts/validate-deployment-env.mjs",
    "validate:ui-preview": "node scripts/validate-ui-preview-env.mjs",
    "validate:staging-readiness": "node scripts/staging-readiness.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "bcryptjs": "^3.0.3",
    "fast-xml-parser": "^5.12.0",
    "next": "^16.4.5",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "web-push": "^4.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.5",
    "typescript": "^5.9.3"
  }
}
